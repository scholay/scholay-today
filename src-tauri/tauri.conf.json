{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scholay today",
  "version": "0.16.0",
  "identifier": "com.thomas.papr",
  "mainBinaryName": "papr-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "node scripts/prepare-mcp.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "scholay today",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 560,
        "backgroundColor": "#FBF9F3",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 13, "y": 19 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["papr"]
      }
    }
  },
  "bundle": {
    "active": true,
    "macOS": { "infoPlist": "Info.plist" },
    "resources": { "../THIRD_PARTY_HOTBOARD.md": "THIRD_PARTY_HOTBOARD.md", "../LICENSE": "LICENSE", "../target/bundle-resources/mcp/": "mcp/" },
    "createUpdaterArtifacts": false,
    "targets": "all",
    "category": "News",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
